{
  "name": "slop-grenade-web",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "node -e \"const{spawnSync}=require('node:child_process');process.exit(spawnSync(process.execPath,['./node_modules/vite/bin/vite.js','build'],{cwd:process.cwd().replace(/^[a-z]:/,m=>m.toUpperCase()),stdio:'inherit'}).status??1)\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node -e \"const{spawnSync}=require('node:child_process');process.exit(spawnSync(process.execPath,['./node_modules/vitest/vitest.mjs','run'],{cwd:process.cwd().replace(/^[a-z]:/,m=>m.toUpperCase()),stdio:'inherit'}).status??1)\""
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.10.10",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge": "4.1.2"
  }
}
