# Rust & Native Windows Desktop build artifacts
/rust/target/
**/target/
/desktop/*.exe
/desktop/*.pdb

# Android build output, local SDK configuration and signing material
/mobile/.gradle/
/mobile/.kotlin/
/mobile/**/build/
/mobile/local.properties
/mobile/**/local.properties
/mobile/scripts/__pycache__/
**/__pycache__/
*.jks
*.keystore
keystore.properties
*.apk
*.aab

# Node / SvelteKit build artifacts
/web/node_modules/
/web/.svelte-kit/
/web/build/
/web/dist/
**/node_modules/

# Local runtime state, tokens, and agent ledgers (never commit secrets or user data)
/.local/
/.agent-work/
.env
.env.*
!.env.example
*.log

# OS & editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
